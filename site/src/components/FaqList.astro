---
/**
 * Portfolio-standard FAQ accordion (National Parks Guide network).
 * Pattern: Lachlan River — question left, + right (rotates to × when open).
 * Native <details> for a11y; no JS. Keep API stable across sister parks.
 */
export type FaqItem = { question: string; answer: string };

interface Props {
  items: FaqItem[];
  /** Optional heading id for aria-labelledby on the list region */
  labelledBy?: string;
  class?: string;
}

const { items, labelledBy, class: className = '' } = Astro.props;
---

{
  items.length > 0 && (
    <div class:list={['space-y-2', className]} role="list" aria-labelledby={labelledBy}>
      <p class="text-sm text-mist-700 dark:text-park-400">Tap a question to expand the answer.</p>
      {items.map((f) => (
        <details class="card group open:border-park-400 open:shadow-sm" role="listitem">
          <summary class="faq-summary flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3.5 font-semibold text-park-900 dark:text-park-50 sm:px-5">
            <span class="min-w-0 flex-1 text-base leading-snug">{f.question}</span>
            <span
              class="shrink-0 text-xl font-light leading-none text-park-600 transition group-open:rotate-45 dark:text-park-300"
              aria-hidden="true"
            >
              +
            </span>
          </summary>
          <div class="border-t border-mist-200 px-4 py-3.5 dark:border-park-700 sm:px-5">
            <p class="text-base leading-relaxed text-mist-700 dark:text-park-200/90">{f.answer}</p>
          </div>
        </details>
      ))}
    </div>
  )
}
