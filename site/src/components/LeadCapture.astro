---
/**
 * Free Practical Planner — direct download (portfolio standard: no email gate).
 * Optional tips mode points people to /contact/ for email reveal.
 */
interface Props {
  heading?: string;
  blurb?: string;
  downloadPath?: string;
  class?: string;
  /**
   * checklist (default): direct free download
   * tips: optional contact link for rare tips (no form backend required)
   */
  mode?: 'checklist' | 'tips';
}

const {
  heading,
  blurb,
  downloadPath = '/downloads/whitsunday-practical-planner.html',
  class: className = '',
  mode = 'checklist',
} = Astro.props;

const isTips = mode === 'tips';
const htmlPath = downloadPath;

const resolvedHeading =
  heading ?? (isTips ? 'Optional: planning tips' : 'Free Whitsunday Islands Practical Planner');
const resolvedBlurb =
  blurb ??
  (isTips
    ? 'The Practical Planner is free — no email required. Prefer a human reply? Use Contact and reveal our email address.'
    : 'Printable boat-access decision tree, Whitehaven + Hill Inlet tide notes, camping vs day-trip comparison, stinger packing and official Queensland Parks links — free direct download, no email gate.');
---

<section
  class:list={[
    'card no-print p-5 sm:p-6',
    isTips
      ? 'border-mist-200 bg-white dark:border-park-700 dark:bg-park-900/40'
      : 'border-park-200 bg-gradient-to-br from-park-50 to-white dark:border-park-700 dark:from-park-900/80 dark:to-park-950',
    className,
  ]}
>
  <h2 class="text-lg font-bold text-park-900 dark:text-park-50">{resolvedHeading}</h2>
  <p class="body-copy mt-2">{resolvedBlurb}</p>

  {
    !isTips && (
      <ul class="mt-3 list-disc space-y-1 pl-5 text-xs text-mist-700 dark:text-park-300">
        <li>Boat access: day tour vs camping transfer vs private</li>
        <li>Whitehaven + Hill Inlet tide &amp; lookout checklist</li>
        <li>Stinger season + self-sufficient camping packing</li>
        <li>Official QPWS / GBRMPA links to verify conditions</li>
      </ul>
    )
  }

  <div class="mt-4 flex flex-wrap gap-3">
    {
      !isTips ? (
        <>
          <a class="btn-primary" href={downloadPath}>Open free Practical Planner</a>
          <a class="btn-secondary !text-sm" href={htmlPath} target="_blank" rel="noopener noreferrer">
            View / print HTML
          </a>
          <a class="btn-secondary !text-sm" href="/contact/">Contact for tips</a>
        </>
      ) : (
        <>
          <a class="btn-primary" href={downloadPath}>Grab free Practical Planner</a>
          <a class="btn-secondary !text-sm" href="/contact/">Email us (reveal address)</a>
        </>
      )
    }
  </div>

  <p class="affiliate-note mt-3 leading-relaxed">
    {
      isTips ? (
        <>
          Free download anytime — no mailing list required. Website feedback via{' '}
          <a href="/contact/" class="underline-offset-2 hover:underline">Contact</a>.{' '}
          <a href="/privacy/" class="underline-offset-2 hover:underline">Privacy</a>.
        </>
      ) : (
        <>
          Free direct download — no email required. Also available anytime from{' '}
          <a href="/maps/" class="underline-offset-2 hover:underline">Maps &amp; resources</a>.{' '}
          <a href="/privacy/" class="underline-offset-2 hover:underline">Privacy</a>.
        </>
      )
    }
  </p>
</section>
