---
import Layout from '../layouts/Layout.astro';
import ContentDate from '../components/ContentDate.astro';
import { official } from '../data/seo';
import { photoCreditList } from '../data/photoCredit';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Disclaimer' },
];
---

<Layout
  title="Disclaimer"
  fullTitle="Disclaimer · Whitsunday Islands National Park Guide"
  description="Disclaimer for the unofficial Whitsunday Islands National Park guide — independence, risk, and Wikimedia Commons photo credits."
  breadcrumbs={crumbs}
>
  <div class="page-container pb-10 pt-4 sm:pb-14 sm:pt-5">
    <article class="prose-park mx-auto max-w-3xl">
      <h1 class="mt-0">Disclaimer</h1>
      <ContentDate prefix="Last updated" class="not-prose mt-3" />

      <p>
        <strong>whitsundayislandsnationalpark.com.au</strong> is an independent, unofficial visitor planning website operated as part of the Farming Domains portfolio.
        It is <strong>not affiliated with, endorsed by, or representative of</strong> Queensland Parks and Wildlife Service (QPWS), the Department of the Environment, Tourism, Science and Innovation,
        the Great Barrier Reef Marine Park Authority (GBRMPA), Ngaro Traditional Owners, commercial tour operators or resorts, Tourism Whitsundays, or any other government agency or commercial operator.
      </p>
      <p>
        Information on camping fees, track distances, grades, boat access, tides, stinger risk, cultural sites, safety and weather is provided for general orientation only
        and may be incomplete or out of date. Always rely on{' '}
        <a href={official.park} target="_blank" rel="noopener noreferrer">official Queensland Parks resources</a>,
        {' '}
        <a href={official.gbrmpaWhitsundays} target="_blank" rel="noopener noreferrer">GBRMPA</a>,
        {' '}marine forecasts, operators and on-site advice for the real place.
      </p>
      <p>
        Tropical marine travel involves risk of injury or death (boats, weather, stingers, heat, isolation). You are responsible for your decisions, fitness, equipment, hydration and weather judgement.
        Content is provided “as is” without warranties of accuracy or completeness. To the maximum extent permitted by law, the operators of this site are not liable for loss or injury arising from use of the information here.
        This site does not provide emergency services. In an emergency call <strong>000</strong>.
      </p>
      <p>
        Affiliate links may earn commissions; see <a href="/affiliate-disclosure/">affiliate disclosure</a>. Camping permits and official park bookings are never affiliated.
      </p>

      <h2 id="images">Images &amp; photo credits</h2>
      <p>
        Primary landscape photographs on this site are real images from <strong>Wikimedia Commons</strong>, used under their stated Creative Commons licences.
        Author, licence and source file are listed below and are also shown in image captions where practical.
        They are <strong>not</strong> official Queensland Parks photographs and may not show exact current conditions, track access or facilities.
        Always rely on QPWS, GBRMPA and on-site information for the real place.
      </p>
      <p>
        The snorkel/coral education image is a real underwater photograph of <strong>Flynn Reef</strong> (Great Barrier Reef near Cairns) — used to illustrate coral and reef etiquette.
        It is <strong>not</strong> a claim that Whitehaven Beach itself has the same fringing coral display (Whitehaven is often sand-bottom swimming with better coral at other Whitsunday sites when conditions allow).
        <strong>Heart Reef</strong> aerial is a Whitsunday location used for scenic-flight context only.
      </p>
      <p>
        Licence short names are as recorded on Commons (e.g. CC BY-SA 4.0). For full licence text, follow each file link.
        We adapt images for web display (resize/compress); attribution still applies.
        Cultural protocols prohibit depicting restricted sacred sites, ceremonies, or people without appropriate permission — we aim to avoid such imagery.
      </p>

      <div class="not-prose mt-6 overflow-x-auto rounded-2xl border border-mist-200 dark:border-park-600">
        <table class="min-w-full text-left text-sm">
          <thead class="bg-park-50 text-park-900 dark:bg-park-800 dark:text-park-50">
            <tr class="border-b border-mist-200 dark:border-park-600">
              <th scope="col" class="px-4 py-3 font-bold">Subject (site use)</th>
              <th scope="col" class="px-4 py-3 font-bold">Author</th>
              <th scope="col" class="px-4 py-3 font-bold">Licence</th>
              <th scope="col" class="px-4 py-3 font-bold">Source</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-mist-200 bg-white dark:divide-park-600 dark:bg-park-950/40">
            {
              photoCreditList.map((c) => (
                <tr>
                  <td class="px-4 py-3 text-mist-700 dark:text-park-300">{c.subject}</td>
                  <td class="px-4 py-3 font-medium text-park-900 dark:text-park-100">{c.credit}</td>
                  <td class="px-4 py-3 text-mist-700 dark:text-park-300">{c.licence}</td>
                  <td class="px-4 py-3">
                    {c.sourceUrl ? (
                      <a
                        class="font-semibold text-park-700 underline-offset-2 hover:underline dark:text-park-300"
                        href={c.sourceUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        Commons file
                      </a>
                    ) : (
                      '—'
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="mt-6">
        For emergencies call <strong>000</strong>. Related:{' '}
        <a href="/terms/">Terms</a> · <a href="/privacy/">Privacy</a> · <a href="/affiliate-disclosure/">Affiliate disclosure</a> · <a href="/contact/">Contact</a>.
      </p>
    </article>
  </div>
</Layout>
