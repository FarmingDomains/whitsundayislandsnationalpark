---
import Layout from '../layouts/Layout.astro';
import { official } from '../data/seo';
import { contentMeta } from '../data/contentMeta';
import { CONTACT_EMAIL_B64_CHUNKS } from '../lib/obfuscate';
---

<Layout
  title="Contact"
  fullTitle="Contact · Whitsunday Islands National Park Guide"
  description="Contact the unofficial Whitsunday Islands National Park guide. Not for park emergencies — use 000 and Queensland Parks (QPWS) for official help."
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Contact' },
  ]}
>
  <div class="page-container pb-10 pt-4 sm:pb-14 sm:pt-5">
    <h1 class="mt-0 text-3xl font-bold sm:text-4xl">Contact</h1>
    <p class="mt-2 text-sm text-mist-700 dark:text-park-400">Page updated {contentMeta.siteReviewed}</p>

    <div class="mt-8 max-w-2xl rounded-2xl border border-warn-200 bg-warn-50 p-5 dark:border-amber-800/50 dark:bg-amber-950/40">
      <h2 class="text-lg font-bold text-warn-800 dark:text-amber-100">Not for park emergencies</h2>
      <p class="mt-2 text-sm text-warn-800/90 dark:text-amber-100/90">
        For emergencies call <strong>000</strong>. For official park information, camping, alerts and conditions use{' '}
        <a class="font-semibold underline-offset-2 hover:underline" href={official.park} target="_blank" rel="noopener noreferrer">Queensland Parks (QPWS) — Whitsunday Islands</a>
        {' '}and{' '}
        <a class="font-semibold underline-offset-2 hover:underline" href={official.alerts} target="_blank" rel="noopener noreferrer">park alerts</a>.
        This channel is only for feedback about this unofficial website.
      </p>
    </div>

    <section id="contact-email-section" class="mt-10 max-w-2xl scroll-mt-28">
      <h2 class="text-xl font-bold">Website feedback</h2>
      <p class="mt-2 text-base text-mist-700 dark:text-park-200/85">
        Corrections, content questions, or commercial enquiries. Operator: <strong>Farming Domains</strong> (ABN 66 786 225 704) on behalf of Ian Piggott.
      </p>

      <div class="contact-email-card mt-6 rounded-2xl border border-mist-200 bg-white p-6 shadow-sm dark:border-park-700 dark:bg-park-900/50">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-park-600 dark:text-park-300">Email</p>
        <button
          type="button"
          id="contact-email"
          class="mt-2 text-left text-lg font-semibold text-park-700 underline-offset-2 hover:underline dark:text-park-300"
          aria-describedby="contact-email-hint"
        >
          Show email address
        </button>
        <p id="contact-email-hint" class="mt-2 text-sm text-mist-700 dark:text-park-400">
          Click to display our contact email (anti-spam). Second click opens your mail app.
        </p>
        <noscript>
          <p class="mt-2 text-sm text-mist-700 dark:text-park-400">
            Enable JavaScript to reveal the contact email, or write to hello at whitsundayislandsnationalpark.com.au (replace “at” with @).
          </p>
        </noscript>
      </div>

      <h3 class="mt-10 text-lg font-bold">What we can help with</h3>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-base text-mist-700 dark:text-park-200/90">
        <li>Clarifying a guide page (Whitehaven, Hill Inlet, boat access, camping, itineraries)</li>
        <li>Flagging outdated descriptions or dead links</li>
        <li>Suggesting a new visitor topic for the Whitsundays</li>
        <li>Privacy, affiliate disclosure, or site feedback</li>
      </ul>

      <h3 class="mt-8 text-lg font-bold">What we cannot do</h3>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-base text-mist-700 dark:text-park-200/90">
        <li>Live track, boat or camping status — use Queensland Parks</li>
        <li>Rescue, lost property, fines, or official complaints</li>
        <li>Act for QPWS, GBRMPA or Ngaro Traditional Owners</li>
        <li>Book camping permits or commercial tours for you</li>
      </ul>
    </section>
  </div>
</Layout>

<script define:vars={{ CONTACT_EMAIL_B64_CHUNKS }}>
  function decodeContactAddress() {
    return atob(CONTACT_EMAIL_B64_CHUNKS.join(''));
  }

  function setupContactEmail() {
    const el = document.getElementById('contact-email');
    if (!el) return;

    let revealedAddress = null;
    const hint = document.getElementById('contact-email-hint');

    el.addEventListener('click', function () {
      if (!revealedAddress) {
        revealedAddress = decodeContactAddress();
        el.textContent = revealedAddress;
        el.classList.add('is-revealed');
        if (hint) hint.textContent = 'Click again to open your email app.';
        return;
      }
      window.location.href = 'm' + 'ail' + 'to:' + revealedAddress;
    });

    el.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        el.click();
      }
    });
  }

  setupContactEmail();
</script>
