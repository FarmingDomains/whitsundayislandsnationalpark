---
/**
 * Contact — no public email (portfolio CONTACT-POLICY 2026-08).
 * Official QPWS / GBRMPA links only; no mailto, Formspree, or address reveal.
 */
import Layout from '../layouts/Layout.astro';
import OfficialResources from '../components/OfficialResources.astro';
import { official } from '../data/seo';
import { contentMeta } from '../data/contentMeta';
---

<Layout
  title="Contact"
  fullTitle="Contact · Whitsunday Islands National Park Guide"
  description="About this unofficial Whitsunday Islands guide. No public email — use Queensland Parks (QPWS) for official park help; 000 for emergencies."
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Contact' },
  ]}
>
  <div class="page-container pb-10 pt-4 sm:pb-14 sm:pt-5">
    <h1 class="mt-0 text-3xl font-bold sm:text-4xl">Contact</h1>
    <p class="mt-2 text-sm text-mist-700 dark:text-park-400">Page updated {contentMeta.siteReviewed}</p>

    <div class="mt-8 max-w-2xl rounded-2xl border border-warn-200 bg-warn-50 p-5 dark:border-amber-800/50 dark:bg-amber-950/40">
      <h2 class="text-lg font-bold text-warn-800 dark:text-amber-100">Not for park emergencies</h2>
      <p class="mt-2 text-base text-warn-800/90 dark:text-amber-100/90">
        For emergencies call <strong>000</strong>. For official park information, camping, alerts and conditions use{' '}
        <a
          class="font-semibold underline-offset-2 hover:underline"
          href={official.park}
          target="_blank"
          rel="noopener noreferrer"
        >
          Queensland Parks (QPWS) — Whitsunday Islands
        </a>
        {' '}and{' '}
        <a
          class="font-semibold underline-offset-2 hover:underline"
          href={official.alerts}
          target="_blank"
          rel="noopener noreferrer"
        >
          park alerts
        </a>
        . For marine park context use{' '}
        <a
          class="font-semibold underline-offset-2 hover:underline"
          href={official.gbrmpaWhitsundays}
          target="_blank"
          rel="noopener noreferrer"
        >
          GBRMPA Whitsundays
        </a>
        . This page is only about this independent unofficial website.
      </p>
    </div>

    <section class="mt-10 max-w-2xl scroll-mt-28">
      <h2 class="text-xl font-bold">This is an independent guide</h2>
      <p class="mt-2 text-base text-mist-700 dark:text-park-200/90">
        <strong class="text-park-900 dark:text-park-50">whitsundayislandsnationalpark.com.au</strong> is not Queensland Parks (QPWS),
        GBRMPA, Ngaro Traditional Owners, Tourism Whitsundays, or any commercial tour operator. We publish practical visitor planning notes only.
      </p>
      <p class="mt-3 text-base text-mist-700 dark:text-park-200/90">
        Operator: <strong>Farming Domains</strong> (ABN 66 786 225 704). See{' '}
        <a class="font-semibold text-park-700 underline-offset-2 hover:underline dark:text-park-300" href="/about/">
          About this guide
        </a>
        .
      </p>
    </section>

    <section class="mt-10 max-w-2xl scroll-mt-28">
      <h2 class="text-xl font-bold">We do not publish a contact email</h2>
      <p class="mt-2 text-base text-mist-700 dark:text-park-200/90">
        To reduce spam and stop wrong-channel enquiries (rescue, camping permits, “is my boat running tomorrow?”),
        this site does <strong>not</strong> display a public mailbox, contact form, or click-to-reveal address.
      </p>
      <p class="mt-3 text-base text-mist-700 dark:text-park-200/90">
        Content is reviewed periodically against official sources. There is no public inbox for private replies.
      </p>
    </section>

    <section class="mt-10 max-w-2xl">
      <h2 class="text-xl font-bold">Where to go instead</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-base text-mist-700 dark:text-park-200/90">
        <li>
          <strong>Park conditions, camping, bookings, permits</strong> — Queensland Parks only (links below)
        </li>
        <li><strong>Marine park / zoning</strong> — GBRMPA Whitsundays access information</li>
        <li><strong>Emergencies</strong> — 000</li>
        <li>
          <strong>How this site works</strong> —{' '}
          <a class="font-semibold text-park-700 underline-offset-2 hover:underline dark:text-park-300" href="/about/">
            About
          </a>
          ,{' '}
          <a
            class="font-semibold text-park-700 underline-offset-2 hover:underline dark:text-park-300"
            href="/privacy/"
          >
            Privacy
          </a>
          ,{' '}
          <a
            class="font-semibold text-park-700 underline-offset-2 hover:underline dark:text-park-300"
            href="/affiliate-disclosure/"
          >
            Affiliate disclosure
          </a>
        </li>
        <li>
          <strong>Planning tools</strong> —{' '}
          <a class="font-semibold text-park-700 underline-offset-2 hover:underline dark:text-park-300" href="/visit/">
            Plan your visit
          </a>
          ,{' '}
          <a class="font-semibold text-park-700 underline-offset-2 hover:underline dark:text-park-300" href="/maps/">
            Maps &amp; free Practical Planner
          </a>
          ,{' '}
          <a
            class="font-semibold text-park-700 underline-offset-2 hover:underline dark:text-park-300"
            href="/itineraries/"
          >
            Itineraries
          </a>
        </li>
      </ul>
    </section>

    <section class="mt-10 max-w-2xl">
      <h2 class="text-xl font-bold">What this guide is for</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-base text-mist-700 dark:text-park-200/90">
        <li>Orientation on Whitehaven, Hill Inlet, boat access and camping self-sufficiency</li>
        <li>Links and framing that send you to live official sources</li>
        <li>Itineraries, walks hubs and Airlie Beach stay context</li>
      </ul>
      <h3 class="mt-8 text-lg font-bold">What we cannot do from this site</h3>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-base text-mist-700 dark:text-park-200/90">
        <li>Live track, boat or camping status</li>
        <li>Rescue, lost property, fines or official complaints</li>
        <li>Act for QPWS, GBRMPA or Ngaro Traditional Owners</li>
        <li>Book camping permits or commercial tours for you</li>
      </ul>
    </section>

    <div class="mt-12">
      <OfficialResources />
    </div>
  </div>
</Layout>
