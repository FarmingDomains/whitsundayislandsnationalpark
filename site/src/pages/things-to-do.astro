---
/**
 * Portfolio-standard Things to do layout (match Wilsons Prom / Blue Mountains):
 * intro + affiliate note → one hero image → 3 decision rule cards → numbered list cards
 * (no per-card photos, no pill-button grids) → all walks index → monetisation → official.
 */
import Layout from '../layouts/Layout.astro';
import MonetisationPanel from '../components/MonetisationPanel.astro';
import OfficialResources from '../components/OfficialResources.astro';
import ContentImage from '../components/ContentImage.astro';
import ContentDate from '../components/ContentDate.astro';
import { official } from '../data/seo';
import { siteImages } from '../data/pageImages';
import { trails } from '../data/trails';
import { affiliateDisclosureShort } from '../data/affiliates';

type CardLink = { href: string; label: string; primary?: boolean };

/**
 * Primary CTA + 1–2 secondary internal links only.
 * Avoid link-stuffing blurbs — hurts scannability and looks spammy.
 */
const activities: {
  n: string;
  title: string;
  blurb: string;
  meta: string;
  href: string;
  links: CardLink[];
}[] = [
  {
    n: '1',
    title: 'Whitehaven Beach + Hill Inlet',
    blurb:
      'The global icon pair: pure silica sand and the tidal swirl lookout (~1.3 km return, moderate steps). Boat access only — day tour is the volume path; camping unlocks quieter hours.',
    href: '/park/whitehaven-hill-inlet/',
    meta: 'Icon pair · boat-gated · tide-aware photos',
    links: [
      { href: '/trails/hill-inlet-lookout/', label: 'Hill Inlet lookout', primary: true },
      { href: '/trails/whitehaven-beach/', label: 'Whitehaven beach guide' },
      { href: '/itineraries/whitehaven-hill-inlet-day/', label: 'Classic day plan' },
    ],
  },
  {
    n: '2',
    title: 'Boat-access day tours',
    blurb:
      'Crewed day products from Airlie Beach / Shute Harbour. Read whether Hill Inlet is included. Weather cancels boats — build a buffer day if the icon is non-negotiable.',
    href: '/park/boat-access-airlie/',
    meta: 'High volume · logistics first · Airlie hub',
    links: [
      { href: '/park/boat-access-airlie/', label: 'Access decision tree', primary: true },
      { href: '/tours/', label: 'Tours hub' },
      { href: '/articles/boat-access-decision-tree/', label: 'Access article' },
    ],
  },
  {
    n: '3',
    title: 'Overnight island camping',
    blurb:
      'QPWS permit + transfer, water packed in, stove only, tag displayed. Whitehaven classic or quieter beaches — solitude costs logistics. This site never sells permits.',
    href: '/park/camping-beaches/',
    meta: 'Permit · self-sufficient · never affiliated',
    links: [
      { href: '/park/camping-beaches/', label: 'Camping beaches hub', primary: true },
      { href: '/itineraries/overnight-whitehaven-camping/', label: 'Overnight plan' },
      { href: '/articles/whitehaven-camping-self-sufficiency/', label: 'Camping article' },
    ],
  },
  {
    n: '4',
    title: 'Fringing reef snorkel',
    blurb:
      'Conditions-dependent sites on commercial itineraries. Stinger suits typically Nov–May. Never stand on coral; trust skipper site changes.',
    href: '/trails/fringing-reef-snorkel/',
    meta: 'Weather-gated · stinger realism',
    links: [
      { href: '/trails/fringing-reef-snorkel/', label: 'Snorkel guide', primary: true },
      { href: '/park/snorkel-reef/', label: 'Reef area' },
      { href: '/park/marine-safety-seasons/', label: 'Safety & seasons' },
    ],
  },
  {
    n: '5',
    title: 'Island walks & lookouts',
    blurb:
      'Short tracks beyond the icon pair — Solway, Dugong/Sawmill links, Chance Bay and more when your landing and energy allow.',
    href: '/park/island-walks-lookouts/',
    meta: 'Short tracks · boat landings',
    links: [
      { href: '/trails/', label: 'All walks', primary: true },
      { href: '/trails/solway-circuit/', label: 'Solway circuit' },
      { href: '/park/island-walks-lookouts/', label: 'Walks area' },
    ],
  },
  {
    n: '6',
    title: 'Ngaro cultural sites',
    blurb:
      'Public interpretive tracks only — stay on path, no restricted rock-art photography, no invented sacred stories. Reef etiquette is Sea Country respect.',
    href: '/trails/ngaro-cultural-site/',
    meta: 'Respect first · public sites only',
    links: [
      { href: '/trails/ngaro-cultural-site/', label: 'Cultural site guide', primary: true },
      { href: '/park/ngaro-culture/', label: 'Culture area' },
      { href: '/articles/ngaro-cultural-site-respectful-visit/', label: 'Respect article' },
    ],
  },
  {
    n: '7',
    title: 'Multi-day sailing',
    blurb:
      'Crewed multi-day sail or qualified bareboat for archipelago immersion. Higher cost and weather sensitivity; still need a flexible Whitehaven attempt day.',
    href: '/itineraries/multi-day-sailing/',
    meta: 'Multi-day · weather buffer',
    links: [
      { href: '/itineraries/multi-day-sailing/', label: 'Sailing itinerary', primary: true },
      { href: '/tours/', label: 'Tours & charters' },
      { href: '/park/advanced-multi-day/', label: 'Advanced area' },
    ],
  },
  {
    n: '8',
    title: 'Scenic flights (Heart Reef)',
    blurb:
      'Premium aerial context — not a substitute for ground-level beach time. Useful after a boat day or when seas cancel surface plans.',
    href: '/tours/',
    meta: 'Aerial · optional layer',
    links: [
      { href: '/tours/', label: 'Tours & flights', primary: true },
      { href: '/visit/', label: 'Plan visit' },
      { href: '/maps/', label: 'Maps' },
    ],
  },
];

const decisionRules = [
  {
    title: 'Day one rule',
    text: 'Pick one primary path (usually a Whitehaven day tour with Hill Inlet if included). Do not stack camping, multi-day sail and Heart Reef on day one.',
  },
  {
    title: 'Weather / boat bail-out',
    text: 'Wind and swell cancel departures. A buffer day, mainland recovery or scenic flight beats forcing the sea. Bail-outs are competence.',
  },
  {
    title: 'Overnight filter',
    text: 'If the group has never self-sufficient camped, stay on day products. Island camping is earned — water weight, stove only, QPWS permit.',
  },
];

const hero = siteImages.homeHero;
---

<Layout
  title="Things to do"
  fullTitle="Things to Do at Whitsunday Islands · Whitehaven, Hill Inlet, Snorkel & Camping"
  description="Whitehaven Beach, Hill Inlet lookout, boat-access day tours, island camping, fringing reef snorkel, Ngaro cultural sites and multi-day sailing — practical things to do at Whitsunday Islands National Park QLD."
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Things to do' },
  ]}
>
  <div class="page-container pb-10 pt-4 sm:pb-14 sm:pt-5">
    <h1 class="mt-0 text-3xl font-bold sm:text-4xl">Things to do at Whitsunday Islands</h1>
    <ContentDate prefix="Last reviewed" class="mt-3" note="· verify live conditions with Queensland Parks" />
    <p class="mt-4 max-w-3xl body-copy">
      Everything is <strong class="text-park-900 dark:text-park-50">boat-access gated</strong> — there is no public road to{' '}
      <a
        href="/trails/whitehaven-beach/"
        class="font-semibold text-park-700 underline-offset-2 hover:underline dark:text-park-300"
      >
        Whitehaven Beach
      </a>
      {' '}or{' '}
      <a
        href="/trails/hill-inlet-lookout/"
        class="font-semibold text-park-700 underline-offset-2 hover:underline dark:text-park-300"
      >
        Hill Inlet lookout
      </a>
      . Most first visits use a crewed day tour from Airlie Beach, with optional{' '}
      <a
        href="/park/camping-beaches/"
        class="font-semibold text-park-700 underline-offset-2 hover:underline dark:text-park-300"
      >
        overnight camping
      </a>
      {' '}or{' '}
      <a
        href="/trails/fringing-reef-snorkel/"
        class="font-semibold text-park-700 underline-offset-2 hover:underline dark:text-park-300"
      >
        snorkel stops
      </a>
      {' '}when weather and stinger risk allow. Multi-day sailing is a different sport. Do not try to collect every product on a first visit.
    </p>
    <p class="affiliate-note mt-3">{affiliateDisclosureShort}</p>

    <div class="mt-8">
      <ContentImage
        src={hero.src}
        alt={hero.alt}
        imageMeta={hero}
        imgClass="max-h-72 w-full object-cover"
        loading="eager"
        priority
      />
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {
        decisionRules.map((r) => (
          <div class="card p-5">
            <h2 class="font-bold text-park-900 dark:text-park-50">{r.title}</h2>
            <p class="mt-2 text-base text-mist-700 dark:text-park-300">{r.text}</p>
          </div>
        ))
      }
    </div>

    <ol class="mt-12 space-y-6">
      {
        activities.map((a) => {
          const primary = a.links.find((l) => l.primary) ?? a.links[0];
          const secondary = a.links.filter((l) => l !== primary);
          return (
            <li class="card p-5 sm:p-6">
              <div class="flex flex-wrap items-start gap-3">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-park-600 text-sm font-bold text-white">
                  {a.n}
                </span>
                <div class="min-w-0 flex-1">
                  <h2 class="text-xl font-bold">
                    <a
                      href={a.href}
                      class="text-park-900 underline-offset-2 hover:underline dark:text-park-50"
                    >
                      {a.title}
                    </a>
                  </h2>
                  <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-park-600 dark:text-park-300">
                    {a.meta}
                  </p>
                  <p class="mt-2 text-base text-mist-700 dark:text-park-300">{a.blurb}</p>
                  <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2">
                    <a
                      href={primary.href}
                      class="inline-flex text-sm font-semibold text-park-700 underline-offset-2 hover:underline dark:text-park-300"
                    >
                      {primary.label} →
                    </a>
                    {
                      secondary.map((l) => (
                        <a
                          href={l.href}
                          class="inline-flex text-xs font-medium text-mist-700 underline-offset-2 hover:text-park-800 hover:underline dark:text-park-400 dark:hover:text-park-200"
                        >
                          {l.label}
                        </a>
                      ))
                    }
                  </div>
                </div>
              </div>
            </li>
          );
        })
      }
    </ol>

    <section class="mt-14">
      <h2 class="text-2xl font-bold">All walks on this guide</h2>
      <p class="mt-2 text-base text-mist-700 dark:text-park-300">
        {trails.length} practical walk, beach and lookout pages with logistics. Always confirm on{' '}
        <a
          class="font-semibold underline-offset-2 hover:underline"
          href={official.park}
          target="_blank"
          rel="noopener noreferrer"
        >
          Queensland Parks
        </a>
        .
      </p>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        {
          trails.map((t) => (
            <li>
              <a
                href={`/trails/${t.slug}/`}
                class="font-semibold text-park-700 underline-offset-2 hover:underline dark:text-park-300"
              >
                {t.shortName}
              </a>
              <span class="text-sm text-mist-700 dark:text-park-400">
                {' '}
                — {t.effort} · {t.time}
              </span>
            </li>
          ))
        }
      </ul>
      <p class="mt-4 flex flex-wrap gap-2">
        <a href="/trails/" class="btn-secondary !text-sm">Walks hub</a>
        <a href="/itineraries/" class="btn-secondary !text-sm">Itineraries</a>
        <a href="/articles/" class="btn-secondary !text-sm">Articles</a>
        <a href="/visit/" class="btn-secondary !text-sm">Plan visit</a>
      </p>
    </section>

    <div class="mt-12">
      <MonetisationPanel
        primaryStay="airlieBeach"
        title="Stays, tours & gear (optional)"
        description="Optional next steps after you pick an activity. Camping permits and official Queensland Parks bookings are never affiliated."
      />
    </div>
    <div class="mt-10">
      <OfficialResources />
    </div>
  </div>
</Layout>
