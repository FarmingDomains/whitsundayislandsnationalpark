---
import Layout from '../../layouts/Layout.astro';
import LeadCapture from '../../components/LeadCapture.astro';
import MonetisationPanel from '../../components/MonetisationPanel.astro';
import ContentDate from '../../components/ContentDate.astro';
import { itineraries } from '../../data/itineraries';
import { imageForItinerary } from '../../data/pageImages';
---

<Layout
  title="Itineraries"
  fullTitle="Whitsunday Islands Itineraries · Day Plans & Multi-Day"
  description="Printable Whitsunday Islands itineraries: Whitehaven + Hill Inlet day trip, overnight camping, secluded beaches, photography tides, family plans, multi-day sailing and Airlie Beach buffers."
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Itineraries' },
  ]}
>
  <div class="page-container pb-10 pt-4 sm:pb-14 sm:pt-5">
    <h1 class="mt-0 text-3xl font-bold sm:text-4xl">Itineraries</h1>
    <ContentDate prefix="Guide updated" class="mt-3" note="· boats & tides first — verify with QPWS & operators" />
    <p class="mt-4 max-w-3xl body-copy">
      These plans are built for real island logistics — boats, tides, weather cancels, camping self-sufficiency and stinger season — not fantasy “tick Whitehaven before lunch” checklists.
      Pick the plan that matches your group, then open it for a full timeline, packing notes and what to skip.
    </p>
    <p class="mt-3 max-w-3xl text-sm text-mist-700 dark:text-park-300">
      Every itinerary still defers to <strong class="text-park-900 dark:text-park-100">Queensland Parks (QPWS)</strong> for track status, camping and alerts,
      and to operators / BOM for marine weather.
    </p>

    <div class="mt-8 grid gap-5 md:grid-cols-2">
      {
        itineraries.map((it) => {
          const img = imageForItinerary(it.slug);
          return (
            <a href={`/itineraries/${it.slug}/`} class="card overflow-hidden transition hover:border-park-400">
              <img
                src={img.src.src}
                alt={img.alt}
                class="h-44 w-full object-cover"
                loading="lazy"
              />
              <div class="p-5">
                <p class="text-xs font-bold uppercase tracking-wide text-park-600 dark:text-park-300">{it.duration}</p>
                <h2 class="mt-1 text-lg font-bold text-park-900 dark:text-park-50">{it.name}</h2>
                <p class="mt-2 text-sm text-mist-700 dark:text-park-300">{it.summary}</p>
                <p class="mt-3 text-xs font-semibold text-park-600 dark:text-park-300">Open plan →</p>
              </div>
            </a>
          );
        })
      }
    </div>

    <div class="mt-12">
      <MonetisationPanel
        primaryStay="airlieBeach"
        title="Stays & tours after you pick a plan"
        description="Book an Airlie Beach base, browse Whitehaven tours, or grab tropical boat kit — after you pick an itinerary that fits weather and energy."
      />
    </div>

    <div class="mt-10">
      <LeadCapture downloadPath="/downloads/whitsunday-practical-planner.html" />
    </div>
  </div>
</Layout>
