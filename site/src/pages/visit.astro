---
/**
 * Visit IA — WPNP structure, Whitsunday park-true content.
 * Map after access/camping, before deep packing/FAQ.
 */
import Layout from '../layouts/Layout.astro';
import WeatherWidget from '../components/WeatherWidget.astro';
import LeadCapture from '../components/LeadCapture.astro';
import MonetisationPanel from '../components/MonetisationPanel.astro';
import OfficialResources from '../components/OfficialResources.astro';
import AdSense from '../components/AdSense.astro';
import FaqList from '../components/FaqList.astro';
import ContentDate from '../components/ContentDate.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { official, faqJsonLd } from '../data/seo';
import { contentMeta } from '../data/contentMeta';
import { affiliateDisclosureShort } from '../data/affiliates';

const faqs = [
  {
    question: 'Do I need a camping permit for a Whitehaven day trip?',
    answer:
      'No. Commercial day tours do not use national park camping permits. Overnight camping on Whitsunday Islands National Park beaches requires a Queensland Parks booking and permit, with fees and a displayed tag. This site never sells permits.',
  },
  {
    question: 'How much is camping?',
    answer:
      'Fees are set by Queensland Parks and change — commonly cited around $7.75 per adult per night or a family rate (children under 5 free under published policy). Always re-check live prices on parks.qld.gov.au camping bookings before you book.',
  },
  {
    question: 'Can I drive to Whitehaven Beach?',
    answer:
      'No. Whitehaven Beach and Hill Inlet are boat-access only. Base in Airlie Beach (or a resort island), then use a day tour, camping transfer, private vessel or multi-day charter.',
  },
  {
    question: 'What is the best time to visit?',
    answer:
      'Dry season (roughly May–October) is generally preferred for more stable weather and whale season opportunities, but it is also peak demand. Wet season brings higher humidity, storm/cyclone risk and stinger awareness if swimming. Build a weather buffer day if Whitehaven is non-negotiable.',
  },
  {
    question: 'When is stinger season?',
    answer:
      'Marine stinger risk is typically highest from November to May in tropical Queensland. Follow Queensland Health and operator guidance; full-body suits are common for snorkelling in season. Always re-check current advice.',
  },
];

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Plan your visit' },
];

const jumpLinks = [
  { href: '#getting-there', label: 'Getting there' },
  { href: '#boat-access', label: 'Boat access' },
  { href: '#camping', label: 'Camping permits' },
  { href: '#map', label: 'Map' },
  { href: '#ngaro', label: 'Ngaro culture' },
  { href: '#marine-safety', label: 'Safety & seasons' },
  { href: '#packing', label: 'Packing' },
  { href: '#weather', label: 'Weather' },
  { href: '#faq', label: 'FAQ' },
];

const summaryCards = [
  {
    href: '#boat-access',
    title: 'Boat access only',
    badge: 'No road',
    lines: [
      'Day tour · camping transfer · private',
      'Airlie Beach primary hub',
      'Weather can cancel boats',
    ],
    cta: 'Access hierarchy',
  },
  {
    href: '#camping',
    title: 'Camping permits',
    badge: 'QPWS only',
    lines: [
      'Overnight needs official booking',
      'Water packed in · no campfires',
      'Never affiliated here',
    ],
    cta: 'Camping notes',
  },
  {
    href: '#map',
    title: 'Map',
    badge: 'Orientation',
    lines: ['Whitehaven / Hill Inlet', 'Airlie Beach hub', 'Shute Harbour node'],
    cta: 'Map section',
  },
  {
    href: '#marine-safety',
    title: 'Safety & seasons',
    badge: 'Stingers · tides',
    lines: ['Stingers typically Nov–May', 'Hill Inlet tide-aware', 'Buffer day if icon is must'],
    cta: 'Safety notes',
  },
];
---

<Layout
  title="Plan your visit"
  fullTitle="Plan Your Visit · Whitsunday Islands National Park"
  description="Plan Whitsunday Islands National Park: boat access from Airlie Beach, camping permits, Hill Inlet tides, stinger season, packing and seasons. Always verify with Queensland Parks (QPWS)."
  breadcrumbs={crumbs}
  jsonLd={faqJsonLd(faqs)}
>
  <div class="page-container pb-10 pt-4 sm:pb-14 sm:pt-5">
    <h1 class="mt-0 text-3xl font-extrabold tracking-tight sm:text-4xl">Plan your visit</h1>
    <p class="mt-4 max-w-2xl text-mist-700 dark:text-park-200">
      Use this page for boat logistics, camping realism, packing and safety. For live fees, track status and alerts, always use{' '}
      <a class="font-semibold text-park-700 underline-offset-2 hover:underline dark:text-park-300" href={official.park} target="_blank" rel="noopener noreferrer">Queensland Parks — Whitsunday Islands</a>.
    </p>
    <ContentDate prefix="Last reviewed" class="mt-3" note="· verify live park facts with Queensland Parks" />
    <p class="affiliate-note mt-3">{affiliateDisclosureShort}</p>

    <nav class="mt-6 flex flex-wrap gap-2" aria-label="On this page">
      {
        jumpLinks.map((l) => (
          <a href={l.href} class="rounded-full border border-park-200 bg-white px-3 py-1.5 text-xs font-semibold text-park-800 hover:border-park-400 dark:border-park-600 dark:bg-park-900 dark:text-park-100">
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        summaryCards.map((card) => (
          <a href={card.href} class="card block p-5 transition hover:border-park-400 hover:shadow-md">
            <p class="text-[10px] font-bold uppercase tracking-wide text-park-600 dark:text-park-300">{card.badge}</p>
            <h2 class="mt-1 text-lg font-bold text-park-900 dark:text-park-50">{card.title}</h2>
            <ul class="mt-3 space-y-1 text-sm text-mist-700 dark:text-park-300">
              {card.lines.map((line) => (
                <li>· {line}</li>
              ))}
            </ul>
            <p class="mt-3 text-xs font-semibold text-park-600 dark:text-park-300">{card.cta} →</p>
          </a>
        ))
      }
    </div>

    <section id="getting-there" class="mt-14 scroll-mt-28 prose-park">
      <h2 class="text-2xl font-bold">Getting there</h2>
      <p class="mt-3 text-mist-700 dark:text-park-200">
        Fly into <strong>Proserpine / Whitsunday Coast (PPP)</strong> or <strong>Hamilton Island (HTI)</strong>, then base for most visitors at{' '}
        <strong>Airlie Beach</strong> (mainland hub for day tours and camping transfers). <strong>Shute Harbour</strong> is a key departure node for many vessels.
      </p>
      <p class="mt-3 text-mist-700 dark:text-park-200">
        There is <strong>no road to Whitehaven Beach or Hill Inlet</strong>. Access is by commercial day tour, camping transfer / water taxi, private vessel, bareboat or multi-day sail charter.
        Confirm operator check-in times and weather cancellation policies before you lock non-refundable flights tight against a single boat day.
      </p>
    </section>

    <section id="boat-access" class="mt-14 scroll-mt-28">
      <h2 class="text-2xl font-bold">Boat-access decision hierarchy</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-base text-mist-700 dark:text-park-300">
        <li><strong>Day tour</strong> — dominant high-volume path; convenience over solitude</li>
        <li><strong>Camping transfer</strong> — overnight immersion; requires QPWS permit + full self-sufficiency</li>
        <li><strong>Private vessel / bareboat / multi-day sail</strong> — freedom path; skills and GBRMPA rules required</li>
      </ul>
      <p class="mt-4 text-sm">
        Deep dive:{' '}
        <a class="font-semibold text-park-700 underline-offset-2 hover:underline dark:text-park-300" href="/park/boat-access-airlie/">boat access &amp; Airlie Beach hub</a>.
      </p>
    </section>

    <section id="camping" class="mt-14 scroll-mt-28">
      <h2 class="text-2xl font-bold">Camping permits (overnight only)</h2>
      <p class="mt-3 max-w-2xl text-mist-700 dark:text-park-200">
        Overnight camping on national park beaches requires a booking through the{' '}
        <a class="font-semibold text-park-700 underline-offset-2 hover:underline dark:text-park-300" href={official.bookings} target="_blank" rel="noopener noreferrer">Queensland Parks Booking Service</a>.
        Fees apply; a tag with your booking number must be displayed. Day tours do not use camping permits.
      </p>
      <p class="mt-3 max-w-2xl text-base text-mist-700 dark:text-park-300">
        Plan water carefully — <strong>no reliable fresh water on most sites</strong> (commonly plan 5 L+ per person per day; verify official advice).
        <strong> No campfires</strong> — stove only. Carry out all waste. Run pest-free / biosecurity checks on boats and gear.
        <strong> We never take commission on camping permits.</strong>
      </p>
      <p class="mt-4 text-sm">
        Official camping page:{' '}
        <a class="font-semibold text-park-700 underline-offset-2 hover:underline dark:text-park-300" href={official.camping} target="_blank" rel="noopener noreferrer">parks.qld.gov.au — Whitsunday camping</a>.
      </p>
    </section>

    <section id="map" class="mt-14 scroll-mt-28">
      <h2 class="text-2xl font-bold">Map — orientation</h2>
      <p class="mt-2 max-w-2xl text-base text-mist-700 dark:text-park-300">
        Islands are boat-access only. Mainland pins (Airlie Beach, Shute Harbour) are logistics hubs, not the beaches themselves. Confirm landings and alerts officially.
      </p>
      <div class="mt-4">
        <MapEmbed
          query="Whitehaven Beach Whitsunday Island Queensland"
          title="Map — Whitehaven Beach & Whitsunday Islands context"
          zoom={11}
          caption="Orientation only. No public road to Whitehaven or Hill Inlet — plan the boat first."
        />
      </div>
      <p class="mt-3 text-sm">
        More pins:{' '}
        <a class="font-semibold text-park-700 underline-offset-2 hover:underline dark:text-park-300" href="/maps/">Maps & downloads</a>.
      </p>
    </section>

    <section id="ngaro" class="mt-14 scroll-mt-28">
      <h2 class="text-2xl font-bold">Ngaro culture &amp; respectful visiting</h2>
      <p class="mt-3 max-w-2xl text-mist-700 dark:text-park-200">
        We acknowledge the <strong>Ngaro people</strong> as Traditional Owners of the Whitsunday islands and surrounding Sea Country.
        Visit public cultural sites only, stay on marked tracks, do not touch rock art, and do not invent restricted stories.
        Prefer authorised guides and operators that respect cultural and marine park protocols.
      </p>
    </section>

    <section id="marine-safety" class="mt-14 scroll-mt-28">
      <h2 class="text-2xl font-bold">Marine safety, stingers, tides &amp; seasons</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-base text-mist-700 dark:text-park-300">
        <li>Wind and swell cancel boats — build a buffer day if Whitehaven is non-negotiable.</li>
        <li>Stinger season is typically <strong>November–May</strong> — full-body suit or avoid swimming; follow operator rules.</li>
        <li>Hill Inlet swirl photography is <strong>tide-dependent</strong> — check BOM tides, not only social media.</li>
        <li>Many landings feel easier mid-to-high tide; trust skippers when they change plans.</li>
        <li>Reef etiquette: no standing on coral, no taking shells/coral, follow GBRMPA zoning if you skipper yourself.</li>
        <li>Recreational drones need proper authorisation — do not assume you can fly.</li>
        <li>Check <a class="font-semibold text-park-700 underline-offset-2 hover:underline dark:text-park-300" href={official.alerts} target="_blank" rel="noopener noreferrer">park alerts</a> the morning you go.</li>
      </ul>
      <p class="mt-4 text-sm">
        More detail:{' '}
        <a class="font-semibold text-park-700 underline-offset-2 hover:underline dark:text-park-300" href="/park/marine-safety-seasons/">marine safety &amp; seasons</a>.
        {' '}Dry season (roughly May–October) is generally preferred for weather stability and whale opportunities — and peak demand for day tours and Airlie beds.
      </p>
    </section>

    <section id="packing" class="mt-14 scroll-mt-28">
      <h2 class="text-2xl font-bold">Packing list (tropical boat + island)</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-base text-mist-700 dark:text-park-300">
        <li>Dry bag + waterproof phone pouch</li>
        <li>UPF shirt, wide-brim hat with cord, polarised sunglasses, reef-safe high-SPF sunscreen</li>
        <li>Closed-toe shoes for Hill Inlet lookout and rocky landings</li>
        <li>Stinger suit / lycra if swimming or snorkelling in season (typically Nov–May)</li>
        <li>Water + snacks for day tours (even when lunch is included, pack backup hydration)</li>
        <li>Campers: collapsible water storage, stove + fuel (no fires), headlamp, waste bags, first aid, comms plan</li>
        <li>Seasickness plan if you are prone; offline booking QR / screenshots</li>
      </ul>
      <p class="mt-4 text-sm">
        See <a class="font-semibold text-park-700 underline-offset-2 hover:underline dark:text-park-300" href="/gear/">gear essentials</a> for Amazon AU product searches (affiliate disclosure applies).
        {' '}Stays: <a class="font-semibold text-park-700 underline-offset-2 hover:underline dark:text-park-300" href="/stay/">where to stay</a>.
      </p>
    </section>

    <section id="weather" class="mt-14 scroll-mt-28">
      <h2 class="text-2xl font-bold">Weather snapshot</h2>
      <p class="mt-2 text-base text-mist-700 dark:text-park-300">
        Widget is orientation only — marine forecasts and operator cancel calls win every argument.
      </p>
      <div class="mt-4">
        <WeatherWidget />
      </div>
    </section>

    <section id="faq" class="mt-14 scroll-mt-28 max-w-3xl" aria-labelledby="visit-faq-heading">
      <h2 id="visit-faq-heading" class="text-2xl font-bold">FAQs</h2>
      <div class="mt-4">
        <FaqList items={faqs} labelledBy="visit-faq-heading" />
      </div>
    </section>

    <AdSense unit="inContent" />

    <div class="mt-12">
      <LeadCapture mode="tips" downloadPath="/downloads/whitsunday-practical-planner.html" />
    </div>

    <div class="mt-12">
      <MonetisationPanel
        primaryStay="airlieBeach"
        title="Book an Airlie Beach base, then add tours & kit"
        description="Stay links first — camping permits remain official-only. Peak season: book accommodation and boats early."
      />
    </div>

    <div class="mt-10">
      <OfficialResources />
    </div>
  </div>
</Layout>
