---
/**
 * Gear hub — BM pattern: ContentDate, ContentImage hero, Amazon grid, no GYG wall.
 */
import Layout from '../layouts/Layout.astro';
import OfficialResources from '../components/OfficialResources.astro';
import ContentImage from '../components/ContentImage.astro';
import ContentDate from '../components/ContentDate.astro';
import MonetisationPanel from '../components/MonetisationPanel.astro';
import {
  affiliates,
  amazonSearchUrl,
  externalRel,
  gearRecommendations,
  affiliateDisclosureShort,
} from '../data/affiliates';
import { siteImages } from '../data/pageImages';
---

<Layout
  title="Gear essentials"
  fullTitle="Whitsunday Boat & Island Gear Essentials"
  description="Tropical packing for Whitsunday Islands: stinger suits, dry bags, reef-safe sunscreen, camping water storage, UPF clothing and more. Amazon AU links with affiliate disclosure."
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Gear' },
  ]}
>
  <div class="page-container pb-10 pt-4 sm:pb-14 sm:pt-5">
    <h1 class="mt-0 text-3xl font-bold sm:text-4xl">Gear essentials for boat + island days</h1>
    <ContentDate prefix="Guide updated" class="mt-3" note="· kit ideas only — verify conditions with Queensland Parks" />
    <p class="mt-4 max-w-3xl body-copy">
      Pack for spray, humidity, silica sand, tides and optional overnight self-sufficiency — not a city beach day.
      Prioritise <strong>waterproofing</strong>, <strong>sun</strong>, and <strong>stinger protection</strong> if swimming in season (typically November–May).
      Campers treat water like a desert walk even though you can see the sea.
    </p>
    <p class="affiliate-note mt-3">
      Product links are Amazon.com.au <strong>searches</strong> (may earn a commission when the Associates tag is active).
      Not brand endorsements. <strong>Park fees and official Queensland Parks bookings are never affiliated.</strong>{' '}
      {affiliateDisclosureShort}{' '}
      <a href="/affiliate-disclosure/" class="underline-offset-2 hover:underline">Affiliate disclosure</a>.
    </p>

    <div class="mt-8">
      <ContentImage
        src={siteImages.boatArrival.src}
        alt={siteImages.boatArrival.alt}
        imageMeta={siteImages.boatArrival}
        imgClass="max-h-64 w-full object-cover"
        loading="eager"
      />
    </div>

    <ul class="mt-10 grid gap-4 sm:grid-cols-2">
      {
        gearRecommendations.map((g) => (
          <li class="card p-5">
            <h2 class="font-bold">
              <a
                class="text-park-800 underline-offset-2 hover:underline dark:text-park-100"
                href={amazonSearchUrl(g.keywords)}
                target="_blank"
                rel={externalRel(affiliates.hasAmazonAffiliate)}
              >
                {g.label}
              </a>
            </h2>
            <p class="mt-2 text-base text-mist-700 dark:text-park-300">{g.note}</p>
            <a
              class="mt-3 inline-block text-xs font-semibold text-park-600 dark:text-park-300"
              href={amazonSearchUrl(g.keywords)}
              target="_blank"
              rel={externalRel(affiliates.hasAmazonAffiliate)}
            >
              Search Amazon.com.au →
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-10 text-sm text-mist-700 dark:text-park-300">
      Pair gear with a realistic plan:{' '}
      <a href="/visit/" class="font-semibold underline-offset-2 hover:underline">Plan your visit</a>
      {' · '}
      <a href="/itineraries/" class="font-semibold underline-offset-2 hover:underline">Itineraries</a>
      {' · '}
      <a href="/maps/" class="font-semibold underline-offset-2 hover:underline">Maps & free planner</a>
      {' · '}
      <a href="/trails/" class="font-semibold underline-offset-2 hover:underline">Walks & lookouts</a>.
    </p>

    <div class="mt-12">
      <MonetisationPanel primaryStay="airlieBeach" showGear={false} showTours={false} title="Stays near your kit list trip" />
    </div>

    <div class="mt-12">
      <OfficialResources />
    </div>
  </div>
</Layout>
