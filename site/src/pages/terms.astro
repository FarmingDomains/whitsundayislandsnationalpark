---
import Layout from '../layouts/Layout.astro';
import ContentDate from '../components/ContentDate.astro';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Terms' },
];
---

<Layout
  title="Terms"
  fullTitle="Terms of Use · Whitsunday Islands National Park Guide"
  description="Terms of use for whitsundayislandsnationalpark.com.au."
  breadcrumbs={crumbs}
>
  <div class="page-container pb-10 pt-4 sm:pb-14 sm:pt-5">
    <article class="prose-park mx-auto max-w-3xl">
      <h1 class="mt-0">Terms of use</h1>
      <ContentDate prefix="Last updated" class="not-prose mt-3" />

      <p>By using whitsundayislandsnationalpark.com.au you agree to these terms.</p>
      <ul>
        <li>Content is for general information and personal trip planning only — not professional advice.</li>
        <li>
          You must not rely on this site as a substitute for official park advice, operator briefings, marine forecasts or emergency services.
        </li>
        <li>
          Outdoor recreation, boat travel, swimming and island camping involve real risk (weather cancels, stingers, marine hazards, isolation).
          You accept responsibility for your safety and decisions.
        </li>
        <li>You must not submit spam, malware or misleading content via contact channels.</li>
        <li>We may change content or discontinue features without notice.</li>
        <li>
          Affiliate and advertising relationships are disclosed in our{' '}
          <a href="/affiliate-disclosure/">affiliate disclosure</a>
          {' '}and on relevant pages. Camping permits and official Queensland Parks bookings are never affiliated.
        </li>
        <li>Do not scrape, republish or misuse content at scale without permission. Personal non-commercial use of itineraries for your own trip is fine.</li>
      </ul>
      <p>
        Content is provided “as is” without warranties of accuracy or fitness for purpose. To the maximum extent permitted by law, we are not liable for loss arising from reliance on this site, third-party bookings, operator cancellations, or conditions in the park or marine park.
      </p>
      <p>Governing law: Queensland, Australia, without prejudice to mandatory consumer protections.</p>
      <p>
        Related: <a href="/disclaimer/">Disclaimer</a> · <a href="/privacy/">Privacy</a> · <a href="/affiliate-disclosure/">Affiliate disclosure</a> · <a href="/contact/">Contact</a>.
      </p>
    </article>
  </div>
</Layout>
