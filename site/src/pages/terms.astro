---
import Layout from '../layouts/Layout.astro';
import ContentDate from '../components/ContentDate.astro';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Terms' },
];
---

<Layout
  title="Terms"
  fullTitle="Terms of Use · Whitsunday Islands National Park Guide"
  description="Terms of use for whitsundayislandsnationalpark.com.au."
  breadcrumbs={crumbs}
>
  <div class="page-container pb-10 pt-4 sm:pb-14 sm:pt-5">
    <h1 class="mt-0 text-3xl font-bold sm:text-4xl">Terms of use</h1>
    <ContentDate prefix="Last updated" class="mt-3" />
    <div class="prose-park mt-6 max-w-3xl">
      <p>
        By using whitsundayislandsnationalpark.com.au you agree these terms. Content is general information only, not professional advice.
        Outdoor recreation, boat travel, swimming and island camping involve real risk — weather cancels trips, stingers and marine hazards exist, and remote beaches have limited rescue options. You accept responsibility for your safety and decisions.
      </p>
      <p>
        Content is provided "as is" without warranties of accuracy or fitness for purpose. We are not liable for loss arising from reliance on this site,
        third-party bookings, operator cancellations, or conditions in the park or marine park. Always verify with Queensland Parks (QPWS), GBRMPA, BOM and your operators before travel.
      </p>
      <p>
        Do not scrape, republish or misuse content at scale without permission. Personal non-commercial use of itineraries for your own trip is fine.
      </p>
      <p>
        See also <a href="/disclaimer/">disclaimer</a>, <a href="/privacy/">privacy</a> and <a href="/affiliate-disclosure/">affiliate disclosure</a>.
      </p>
    </div>
  </div>
</Layout>
