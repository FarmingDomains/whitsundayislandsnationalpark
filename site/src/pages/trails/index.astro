---
import Layout from '../../layouts/Layout.astro';
import TrailCard from '../../components/TrailCard.astro';
import OfficialResources from '../../components/OfficialResources.astro';
import ContentImage from '../../components/ContentImage.astro';
import ContentDate from '../../components/ContentDate.astro';
import { trails } from '../../data/trails';
import { official } from '../../data/seo';
import { siteImages } from '../../data/pageImages';

const easy = trails.filter((t) => t.effort === 'easy');
const moderate = trails.filter((t) => t.effort === 'moderate');
const hard = trails.filter((t) => t.effort === 'hard');
---

<Layout
  title="Walks & lookouts"
  fullTitle="Whitsunday Islands Walks · Hill Inlet, Whitehaven & Island Tracks"
  description="Whitsunday Islands walks and activities: Hill Inlet lookout, Whitehaven Beach, short island tracks, camping beach links, Ngaro Cultural Site and Ngaro Track overview. Verify status with Queensland Parks."
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Walks' },
  ]}
>
  <div class="page-container pb-10 pt-4 sm:pb-14 sm:pt-5">
    <h1 class="mt-0 text-3xl font-bold sm:text-4xl">Walks, beaches & lookouts</h1>
    <ContentDate prefix="Guide updated" class="mt-3" note="· verify track status with Queensland Parks" />
    <p class="mt-4 max-w-3xl body-copy">
      Start with boat logistics, then the icon pair <strong>Whitehaven Beach + Hill Inlet lookout</strong> (~1.3 km return, moderate, ~40 min walking)
      when your tour or transfer includes both. Short island tracks and camping-beach links add depth; multi-day Ngaro Track is advanced and limited.
      Distances, grades and times below are planning ranges — always confirm on{' '}
      <a class="font-semibold text-park-700 underline-offset-2 hover:underline dark:text-park-300" href={official.park} target="_blank" rel="noopener noreferrer">Queensland Parks</a>
      {' '}and the{' '}
      <a class="font-semibold text-park-700 underline-offset-2 hover:underline dark:text-park-300" href={official.hillInlet} target="_blank" rel="noopener noreferrer">Hill Inlet lookout track</a> page.
    </p>

    <div class="mt-8">
      <ContentImage
        src={siteImages.hillInlet.src}
        alt={siteImages.hillInlet.alt}
        imageMeta={siteImages.hillInlet}
        imgClass="max-h-64 w-full object-cover"
      />
    </div>

    <div class="mt-10 overflow-x-auto">
      <table class="w-full min-w-[32rem] border-collapse text-left text-sm">
        <caption class="sr-only">Walk comparison — effort, time and distance</caption>
        <thead>
          <tr class="border-b border-park-200 dark:border-park-700">
            <th class="py-2 pr-3 font-bold">Walk</th>
            <th class="py-2 pr-3 font-bold">Effort</th>
            <th class="py-2 pr-3 font-bold">Time</th>
            <th class="py-2 font-bold">Distance</th>
          </tr>
        </thead>
        <tbody>
          {
            trails.map((t) => (
              <tr class="border-b border-mist-200 dark:border-park-800">
                <td class="py-2.5 pr-3">
                  <a class="font-semibold text-park-800 underline-offset-2 hover:underline dark:text-park-100" href={`/trails/${t.slug}/`}>
                    {t.shortName}
                  </a>
                </td>
                <td class="py-2.5 pr-3 capitalize">{t.effort}</td>
                <td class="py-2.5 pr-3">{t.time}</td>
                <td class="py-2.5">{t.distance}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="mt-4 text-xs text-mist-700 dark:text-park-400">
      Comparison is for scannability only — open each guide and verify live status. Easy: {easy.length} · Moderate: {moderate.length} · Hard: {hard.length}.
    </p>

    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {trails.map((t) => <TrailCard trail={t} />)}
    </div>

    <div class="mt-12">
      <OfficialResources />
    </div>
  </div>
</Layout>
