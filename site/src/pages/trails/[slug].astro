---
/**
 * Trail detail — ContentDate, mid-page Optional kit, showTours false.
 */
import Layout from '../../layouts/Layout.astro';
import FactChips from '../../components/FactChips.astro';
import DontGetThisWrong from '../../components/DontGetThisWrong.astro';
import OfficialResources from '../../components/OfficialResources.astro';
import MonetisationPanel from '../../components/MonetisationPanel.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import ContentImage from '../../components/ContentImage.astro';
import ContentDate from '../../components/ContentDate.astro';
import { trails, getTrail } from '../../data/trails';
import { getArea } from '../../data/areas';
import { touristAttractionJsonLd } from '../../data/seo';
import { imageForTrail } from '../../data/pageImages';
import { contentMeta } from '../../data/contentMeta';
import {
  amazonSearchUrl,
  externalRel,
  affiliates,
  type BookingDestination,
} from '../../data/affiliates';

export function getStaticPaths() {
  return trails.map((t) => ({ params: { slug: t.slug } }));
}

const { slug } = Astro.params;
const trail = getTrail(slug!);
if (!trail) throw new Error(`Unknown trail: ${slug}`);

const area = getArea(trail.areaSlug);
const pair = trail.pairWith ? getTrail(trail.pairWith) : undefined;
const trailImage = imageForTrail(trail.slug);

const jsonLd = touristAttractionJsonLd({
  name: trail.name,
  description: trail.summary,
  url: `/trails/${trail.slug}/`,
});

const primaryStay: BookingDestination = 'airlieBeach';

type GearHint = { label: string; keywords: string };
function gearHintsFor(s: string, effort: string): GearHint[] {
  if (s === 'hill-inlet-lookout' || s === 'whitehaven-beach') {
    return [
      { label: 'Closed-toe grip shoes', keywords: 'water shoes trail shoes grip hiking' },
      { label: 'Dry bag 10–20 L', keywords: 'dry bag waterproof 20L boat' },
      { label: 'Reef-safe SPF + hat', keywords: 'reef safe SPF 50 sunscreen zinc' },
      { label: 'Polarised sunglasses', keywords: 'polarised sunglasses boat marine' },
    ];
  }
  if (s === 'fringing-reef-snorkel') {
    return [
      { label: 'Stinger suit / lycra', keywords: 'stinger suit lycra full body snorkel' },
      { label: 'Reef-safe sunscreen', keywords: 'reef safe SPF 50 sunscreen zinc' },
      { label: 'Waterproof phone pouch', keywords: 'waterproof phone pouch floating' },
    ];
  }
  if (s === 'ngaro-track-overview' || s === 'chance-bay-track' || s === 'dugong-sawmill') {
    return [
      { label: 'Collapsible water jugs', keywords: 'collapsible water container camping 10L' },
      { label: 'Camping stove + fuel', keywords: 'camping stove canister fuel lightweight' },
      { label: 'Headlamp', keywords: 'camping headlamp rechargeable waterproof' },
      { label: 'Dry bag', keywords: 'dry bag waterproof camping boat' },
    ];
  }
  if (effort === 'moderate' || effort === 'hard') {
    return [
      { label: 'Closed-toe trail shoes', keywords: 'trail shoes hiking grip' },
      { label: 'Water 2L capacity', keywords: 'hydration bladder bottle hiking 2 litre' },
      { label: 'UPF long-sleeve', keywords: 'UPF long sleeve rash shirt sun protection' },
      { label: 'First-aid / blister kit', keywords: 'hiking first aid blister kit' },
    ];
  }
  return [
    { label: 'Reef-safe SPF', keywords: 'reef safe SPF 50 sunscreen' },
    { label: 'Wide-brim hat with cord', keywords: 'wide brim sun hat chin strap boat' },
  ];
}

const gearHints = gearHintsFor(trail.slug, trail.effort);
const metaNote = area?.name ? `· ${area.name}` : `· ${contentMeta.siteReviewed}`;
---

<Layout
  title={trail.shortName}
  fullTitle={`${trail.name} · Whitsunday Islands National Park`}
  description={trail.summary}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Walks', href: '/trails/' },
    { name: trail.shortName },
  ]}
  jsonLd={jsonLd}
>
  <div class="page-container pb-10 pt-4 sm:pb-14 sm:pt-5">
    <h1 class="mt-0 text-3xl font-bold sm:text-4xl">{trail.name}</h1>
    <ContentDate prefix="Guide updated" class="mt-3" note={metaNote} />
    <p class="mt-4 max-w-3xl text-base text-mist-700 dark:text-park-200/90 sm:text-lg">{trail.summary}</p>

    <div class="mt-6">
      <FactChips
        items={[
          trail.gradeLabel,
          trail.time,
          trail.distance,
          `Effort: ${trail.effort}`,
          `Best for: ${trail.bestFor}`,
        ]}
      />
    </div>

    <p class="mt-4 text-sm text-amber-900 dark:text-amber-100/90">{trail.verifyNote}</p>
    <a class="btn-primary mt-4 !text-sm" href={trail.officialUrl} target="_blank" rel="noopener noreferrer">
      Official Queensland Parks info (verify status)
    </a>

    <div class="mt-8">
      <ContentImage
        src={trailImage.src}
        alt={trailImage.alt}
        imageMeta={trailImage}
        imgClass="max-h-80 w-full object-cover"
      />
    </div>

    <section id="start" class="mt-10 scroll-mt-28 rounded-2xl border-2 border-park-300 bg-park-50 p-5 sm:p-6 dark:border-park-600 dark:bg-park-900/50">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-park-600 dark:text-park-300">Where you start</p>
      <h2 class="mt-2 text-2xl font-bold text-park-900 dark:text-park-50">{trail.startName}</h2>
      <p class="mt-3 max-w-3xl text-mist-700 dark:text-park-200/90">{trail.startDetail}</p>
    </section>

    <section id="getting-there" class="mt-10 scroll-mt-28">
      <h2 class="text-2xl font-bold">How to get there</h2>
      <ol class="mt-4 list-decimal space-y-3 pl-5 text-mist-700 dark:text-park-200/90">
        {trail.gettingThere.map((step) => <li class="pl-1">{step}</li>)}
      </ol>
    </section>

    <section id="how-to" class="mt-10 scroll-mt-28">
      <h2 class="text-2xl font-bold">How to do it (step by step)</h2>
      <ol class="mt-4 list-decimal space-y-3 pl-5 text-mist-700 dark:text-park-200/90">
        {trail.howToDoIt.map((step) => <li class="pl-1">{step}</li>)}
      </ol>
    </section>

    <DontGetThisWrong items={trail.hazards} title="Hazards & hard truths" />

    {
      trail.body?.map((block) => (
        <section id={block.id} class="mt-10 scroll-mt-28">
          <h2 class="text-2xl font-bold">{block.title}</h2>
          {block.paragraphs.map((p) => (
            <p class="mt-3 max-w-3xl text-mist-700 dark:text-park-200/90">{p}</p>
          ))}
        </section>
      ))
    }

    {
      gearHints.length > 0 && (
        <aside class="mt-10 scroll-mt-28 rounded-2xl border border-park-200 bg-white p-5 dark:border-park-700 dark:bg-park-900/40 sm:p-6">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-park-600 dark:text-park-300">
            Optional kit · after the plan is solid
          </p>
          <h2 class="mt-1 text-lg font-bold text-park-900 dark:text-park-50">Useful gear searches</h2>
          <p class="mt-2 text-base text-mist-700 dark:text-park-300">
            Only if you still need kit. Amazon.com.au search links — not brand rankings. Conditions and official Queensland Parks
            advice come first.
          </p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {gearHints.map((g) => (
              <li>
                <a
                  href={amazonSearchUrl(g.keywords)}
                  class="inline-flex rounded-full border border-park-200 bg-park-50/80 px-3.5 py-2 text-xs font-semibold text-park-800 transition hover:border-park-400 dark:border-park-600 dark:bg-park-950 dark:text-park-100"
                  target="_blank"
                  rel={externalRel(affiliates.hasAmazonAffiliate)}
                >
                  {g.label}
                </a>
              </li>
            ))}
          </ul>
          <p class="affiliate-note mt-3 text-[11px]">
            Amazon search links{affiliates.hasAmazonAffiliate ? ' may earn a commission' : ''} · park fees never
            affiliated ·{' '}
            <a href="/affiliate-disclosure/" class="underline-offset-2 hover:underline">Disclosure</a>
            {' · '}
            <a href="/gear/" class="underline-offset-2 hover:underline">Gear list</a>
          </p>
        </aside>
      )
    }

    <section id="map" class="mt-10 scroll-mt-28">
      <h2 class="text-2xl font-bold">Map (orientation)</h2>
      <p class="mt-2 text-base text-mist-700 dark:text-park-300">
        Pin may be approximate. Confirm landings, boat logistics and track status on Queensland Parks before you go — there is no public road to these places.
      </p>
      <div class="mt-4">
        <MapEmbed query={trail.mapQuery} title={`Map — ${trail.shortName}`} zoom={14} />
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-2xl font-bold">Extra tips</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-base text-mist-700 dark:text-park-200/90">
        {trail.tips.map((t) => <li>{t}</li>)}
      </ul>
    </section>

    {
      pair && (
        <p class="mt-8 text-sm">
          Often paired with{' '}
          <a class="font-semibold text-park-700 underline-offset-2 hover:underline dark:text-park-300" href={`/trails/${pair.slug}/`}>
            {pair.shortName}
          </a>
          — only if energy and weather allow.
        </p>
      )
    }

    {
      area && (
        <p class="mt-4 text-sm">
          Area guide:{' '}
          <a class="font-semibold text-park-700 underline-offset-2 hover:underline dark:text-park-300" href={`/park/${area.slug}/`}>
            {area.name}
          </a>
        </p>
      )
    }

    <section class="mt-12 space-y-6 no-print" aria-label="Stays, gear and official resources">
      <MonetisationPanel
        title="Stays & gear for this kind of day"
        primaryStay={primaryStay}
        showTours={false}
        description="Optional stays and practical kit — after you have checked conditions yourself. Tours stay off pure trail how-tos."
      />
      <OfficialResources extraLinks={[{ href: trail.officialUrl, label: 'Official park / track context' }]} />
    </section>
  </div>
</Layout>
