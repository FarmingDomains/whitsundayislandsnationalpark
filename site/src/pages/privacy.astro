---
import Layout from '../layouts/Layout.astro';
import ContentDate from '../components/ContentDate.astro';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Privacy' },
];
---

<Layout
  title="Privacy"
  fullTitle="Privacy Policy · Whitsunday Islands National Park Guide"
  description="Privacy policy for whitsundayislandsnationalpark.com.au — analytics, ungated downloads, affiliates and cookies."
  breadcrumbs={crumbs}
>
  <div class="page-container pb-10 pt-4 sm:pb-14 sm:pt-5">
    <h1 class="mt-0 text-3xl font-bold sm:text-4xl">Privacy policy</h1>
    <ContentDate prefix="Last updated" class="mt-3" />
    <div class="prose-park mt-6 max-w-3xl">
      <p>
        This site is operated by Farming Domains / Ian Piggott publishing (independent). It is not operated by Queensland Parks (QPWS).
      </p>
      <h2>What we collect</h2>
      <ul>
        <li>Optional contact email reveal only (no form-product wall on this page)</li>
        <li>Standard server and analytics logs (if GA4 or similar is enabled)</li>
        <li>Advertising and affiliate cookies/pixels when AdSense, Booking, GetYourGuide or Amazon tags are active</li>
      </ul>
      <h2>Downloads — no email gate</h2>
      <p>
        Free planning downloads (for example the Whitsunday Practical Planner) are <strong>ungated</strong> — you can open or save the HTML/PDF without submitting an email.
        We do not require an email gate to access downloads on this site.
      </p>
      <h2>How we use information</h2>
      <p>
        To respond to enquiries you initiate, improve content, measure traffic and attribute affiliate referrals.
        We do not sell personal information.
      </p>
      <h2>Third parties</h2>
      <p>
        Hosting providers, analytics, ad networks and affiliate networks process data under their own policies when you use those features.
      </p>
      <h2>Contact</h2>
      <p>
        Privacy questions: use the <a href="/contact/">contact page</a> (Show email). Do not send medical emergencies or park incident reports here — call 000 and use official park channels.
      </p>
    </div>
  </div>
</Layout>
