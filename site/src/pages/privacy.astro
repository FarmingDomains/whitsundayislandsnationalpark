---
import Layout from '../layouts/Layout.astro';
import ContentDate from '../components/ContentDate.astro';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Privacy' },
];
---

<Layout
  title="Privacy"
  fullTitle="Privacy Policy · Whitsunday Islands National Park Guide"
  description="Privacy policy for whitsundayislandsnationalpark.com.au — analytics, ungated downloads, affiliates and cookies."
  breadcrumbs={crumbs}
>
  <div class="page-container pb-10 pt-4 sm:pb-14 sm:pt-5">
    <article class="prose-park mx-auto max-w-3xl">
      <h1 class="mt-0">Privacy policy</h1>
      <ContentDate prefix="Last updated" class="not-prose mt-3" />

      <p>
        This site is operated by Farming Domains / Ian Piggott publishing (independent). It is not operated by Queensland Parks (QPWS).
      </p>

      <h2>What we collect</h2>
      <ul>
        <li>This site does <strong>not</strong> publish a public contact email or contact form — we do not collect mailbox enquiries via this website</li>
        <li>Standard server and analytics logs (if GA4 or similar is enabled)</li>
        <li>Advertising and affiliate cookies/pixels when AdSense, Booking, GetYourGuide or Amazon tags are active</li>
      </ul>

      <h2>Downloads — no email gate</h2>
      <p>
        Free planning downloads (for example the Whitsunday Practical Planner) are <strong>ungated</strong> — you can open or save the HTML without submitting an email.
        We do not require an email gate to access downloads on this site.
      </p>

      <h2>How we use information</h2>
      <p>
        To improve content, measure traffic and attribute affiliate referrals where those features are active.
        We do not sell personal information.
      </p>

      <h2>Third parties</h2>
      <p>
        Hosting providers, analytics, ad networks and affiliate networks process data under their own policies when you use those features.
        Sponsored commercial links are described in our <a href="/affiliate-disclosure/">affiliate disclosure</a>.
      </p>

      <h2>Contact</h2>
      <p>
        This site has <strong>no public email inbox</strong>. See the <a href="/contact/">contact page</a> for official Queensland Parks / GBRMPA links and policy.
        Do not treat this website as a channel for medical emergencies or park incident reports — call <strong>000</strong> and use official park channels.
      </p>
    </article>
  </div>
</Layout>
